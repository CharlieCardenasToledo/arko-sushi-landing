---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ogImage } from '../data/imagenes';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  header?: boolean;
}

const { title, description, noindex = false, header = true } = Astro.props;
const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const base = import.meta.env.BASE_URL;
const staticAsset = (path: string) => `${base.replace(/\/$/, '')}/${path.replace(/^\/+/, '')}`;
const canonical = Astro.site;
const ogUrl = Astro.site ? new URL('og-image.jpg', Astro.site) : new URL(ogImage.src, Astro.url);
---

<!doctype html>
<html lang="es-EC">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#131209" />

    <meta name="author" content="Charlie Cárdenas Toledo" />
    <link rel="icon" type="image/svg+xml" href={staticAsset('favicon.svg')} />
    <link rel="manifest" href={staticAsset('site.webmanifest')} />
    <link rel="sitemap" type="application/xml" href={staticAsset('sitemap-index.xml')} />
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang="es-EC" href={canonical} />
          <link rel="alternate" hreflang="x-default" href={canonical} />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:site_name" content="Cocina ecuatoriana · Demo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:secure_url" content={ogUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={ogImage.alt} />

    <Font cssVariable="--font-hina" preload />
    <Font cssVariable="--font-zen" preload />

    <slot name="head" />
  </head>
  <body class="min-h-svh overflow-x-clip">
    {header && <Header />}
    <main id="contenido" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
