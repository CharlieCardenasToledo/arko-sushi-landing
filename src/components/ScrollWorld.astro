---
import { Picture } from 'astro:assets';
import Pending from './Pending.astro';
import Stop from './Stop.astro';
import { links, paseo } from '../data/arko';

const { paradas } = paseo;
const body = 'mt-4 max-w-md text-base text-crema/80 lg:text-lg';
const title = 'mt-4 max-w-xl text-4xl lg:text-5xl xl:text-6xl';
const pill = 'rounded-full bg-bg/40 px-3 py-1 ring-1 ring-crema/20 backdrop-blur-md';
---

<section id="recorrido" data-world aria-label="Recorrido visual de una propuesta ecuatoriana" class="relative">
  <!-- Escenario fijo: los clips del paseo ocupan toda la pantalla. Debajo, el primer fotograma de cada clip, con el mismo
       encuadre, para que el vídeo entre sin que se note el cambio. -->
  <div data-stage class="sticky top-0 h-lvh overflow-hidden bg-bg" style="--focus-x: 50%">
    <div aria-hidden="true" class="absolute inset-0">
      {
        paradas.map((parada, i) => (
          <div data-frame class="frame absolute inset-0" style={i === 0 ? undefined : 'opacity: 0'}>
            <Picture
              src={parada.poster}
              alt=""
              formats={['avif', 'webp']}
              widths={[828, 1280, 1920]}
              sizes="(min-aspect-ratio: 16/9) 100vw, 178vh"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'low'}
              decoding="async"
              pictureAttributes={{ class: 'block size-full' }}
              class="size-full object-cover"
              style="object-position: var(--focus-x) 50%"
            />
          </div>
        ))
      }
      <div class="clips absolute inset-0">
        {
          paradas.map((parada) => (
            <video
              data-clip
              data-src={parada.clip}
              muted
              playsinline
              preload="none"
              disablepictureinpicture
              disableremoteplayback
              tabindex="-1"
              class="clip absolute inset-0 size-full object-cover"
            />
          ))
        }
      </div>
    </div>

    <!-- Velos para leer el texto encima del vídeo. -->
    <div aria-hidden="true" class="absolute inset-x-0 top-0 h-40 bg-linear-to-b from-bg/60 to-transparent"></div>
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-linear-to-t from-bg from-15% via-bg/50 via-50% to-transparent to-80% lg:bg-linear-to-r lg:from-bg/90 lg:via-bg/40 lg:via-35% lg:to-transparent lg:to-65%"
    >
    </div>
    <div aria-hidden="true" class="absolute inset-x-0 bottom-0 hidden h-1/2 bg-linear-to-t from-bg/80 to-transparent lg:block"></div>

    <!-- Raíl de paradas. -->
    <nav aria-label="Paradas del paseo" class="absolute top-1/2 right-6 hidden -translate-y-1/2 lg:block xl:right-8">
      <ol class="relative flex flex-col items-end gap-4">
        <span aria-hidden="true" class="absolute top-3 right-1 bottom-3 w-px translate-x-1/2 bg-crema/20">
          <span data-rail-fill class="absolute inset-0 origin-top scale-y-0 bg-teja"></span>
        </span>
        {
          paradas.map((parada, i) => (
            <li>
              <a href={`#${parada.id}`} data-goto aria-current={i === 0 ? 'true' : 'false'} class="rail-link group flex h-6 items-center gap-3">
                <span class="rail-label rounded-full bg-bg/60 px-3 py-1 text-xs whitespace-nowrap text-crema ring-1 ring-crema/10 backdrop-blur-xl">
                  {parada.lugar}
                </span>
                <span class="relative grid size-2 place-items-center">
                  <span class="rail-dot size-2 rounded-full bg-crema/50" />
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <p
      data-hint
      aria-hidden="true"
      class="absolute right-8 bottom-8 hidden items-center gap-3 text-xs tracking-widest text-crema/70 uppercase lg:flex"
    >
      Desliza para recorrer el concepto
      <span class="hint-line relative block h-8 w-px overflow-hidden bg-crema/20"></span>
    </p>
  </div>

  <!-- Paradas: cada una deja su texto abajo a la izquierda mientras el paseo avanza. -->
  <div class="relative z-10 -mt-[100lvh]">
    <Stop index={0} spy="#inicio">
      <h1 class="mt-4">
        <span class="block font-sans text-xs font-medium tracking-widest text-teja uppercase">
          Prototipo visual · Ecuador
        </span>
        <span
          class="hero-title mt-4 block max-w-[680px] bg-linear-to-r from-crema to-[#b3a894] bg-clip-text pb-2 text-4xl text-transparent lg:text-6xl"
        >
          Sabores de Ecuador,<br /> en una experiencia por descubrir
        </span>
      </h1>
      <p class={body}>
        Una propuesta de demostración inspirada en ingredientes ecuatorianos y en el encuentro de distintas tradiciones culinarias.
      </p>
      <a href="#experiencias" class="btn btn-primary mt-6"><span>Explorar propuesta</span></a>
      <ul class="mt-6 flex flex-wrap gap-2 text-xs text-crema/80" aria-label="Sobre el prototipo">
        <li class={pill}>Inspirado en Ecuador</li>
        <li class={pill}>Contenido de ejemplo</li>
        <li class={pill}>Sin reservas ni pagos</li>
        <li class={pill}>Imágenes de referencia: Arko Restaurant · Barcelona</li>
      </ul>
    </Stop>

    <Stop index={1} eyebrow="Inspiración ecuatoriana">
      <h2 class={title}>Un encuentro de sabores y culturas</h2>
      <p class={body}>
        Este concepto explora una posible cocina nikkei en Ecuador, con ingredientes de la región y una mirada contemporánea.
      </p>
      <p class="mt-4 max-w-md text-sm text-crema/60">
        La ciudad, el equipo y el origen de los productos están por definir.
      </p>
    </Stop>

    <Stop index={2} eyebrow="Valores de ejemplo">
      <h2 class={title}>Una propuesta para compartir</h2>
      <p class={body}>Estos valores son solo una referencia visual. No corresponden a una oferta real.</p>
      <dl class="mt-6 grid w-full max-w-md grid-cols-3 gap-4">
        <div class="flex flex-col-reverse gap-1">
          <dt class="text-xs text-crema/60">Recorrido de sabores · demo</dt>
          <dd class="font-display text-2xl lg:text-4xl">$40 USD</dd>
        </div>
        <div class="flex flex-col-reverse gap-1">
          <dt class="text-xs text-crema/60">Temporada · demo</dt>
          <dd class="font-display text-2xl lg:text-4xl">$65 USD</dd>
        </div>
        <div class="flex flex-col-reverse gap-1">
          <dt class="text-xs text-crema/60">Bebidas · demo</dt>
          <dd class="font-display text-2xl lg:text-4xl">$15 USD</dd>
        </div>
      </dl>
      <a href="#experiencias" class="link mt-6 text-sm">Ver ejemplos de menú</a>
    </Stop>

    <Stop index={3} eyebrow="Ingredientes por definir">
      <h2 class={title}>Una cocina conectada con su entorno</h2>
      <p class={body}>
        El menú final deberá indicar procedencia, alérgenos y disponibilidad de cada ingrediente antes de ofrecerse al público.
      </p>
      <ul class="mt-6 grid w-full max-w-md grid-cols-2 gap-4">
        <li class="flex flex-col gap-1 rounded-2xl bg-bg/40 p-4 ring-1 ring-crema/15 backdrop-blur-md">
          <span class="font-display text-2xl lg:text-3xl">Origen</span>
          <span class="text-xs text-crema/70 lg:text-sm">Por confirmar para cada producto</span>
        </li>
        <li class="flex flex-col gap-1 rounded-2xl bg-bg/40 p-4 ring-1 ring-crema/15 backdrop-blur-md">
          <span class="font-display text-2xl lg:text-3xl">Alérgenos</span>
          <span class="text-xs text-crema/70 lg:text-sm">Información pendiente de validación</span>
        </li>
      </ul>
    </Stop>

    <Stop index={4} eyebrow="Producto local">
      <h2 class={title}>Cada ingrediente cuenta su origen</h2>
      <p class={body}>
        La selección de productores, ingredientes y técnicas se definirá cuando exista información verificada del negocio.
      </p>
      <div class="mt-6 flex items-end gap-4">
        <span class="font-display text-5xl text-teja lg:text-7xl">EC</span>
        <span class="max-w-48 pb-1 text-sm text-crema/70">Ecuador: punto de partida de esta propuesta visual</span>
      </div>
    </Stop>

    <Stop index={5} eyebrow="Cómo funciona">
      <h2 class={title}>Una experiencia por construir</h2>
      <ol class="mt-6 flex max-w-md flex-col gap-4">
        <li class="flex gap-4">
          <span class="font-display text-2xl text-teja">1</span>
          <div>
            <h3 class="text-lg">Define la propuesta</h3>
            <p class="text-sm text-crema/70">Nombre, ciudad, menú y datos reales del negocio.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="font-display text-2xl text-teja">2</span>
          <div>
            <h3 class="text-lg">Valida la información</h3>
            <p class="text-sm text-crema/70">Precios, horarios, ubicación, alérgenos y contacto.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="font-display text-2xl text-teja">3</span>
          <div>
            <h3 class="text-lg">Publica el sitio final</h3>
            <p class="text-sm text-crema/70">Habilita reservas solo cuando el servicio esté preparado.</p>
          </div>
        </li>
      </ol>
      <a href="#contacto" class="btn btn-primary mt-6"><span>Ver créditos de desarrollo</span></a>
    </Stop>
  </div>
</section>

<style>
  .frame {
    will-change: opacity, transform;
  }

  .clips {
    opacity: 0;
    transition: opacity 1200ms var(--ease-fluid);
  }

  [data-mode='video'] .clips {
    opacity: 1;
  }

  /* Solo se ve el clip del tramo actual; el cambio entre clips es instantáneo porque comparten fotograma. */
  .clip {
    object-position: var(--focus-x) 50%;
    visibility: hidden;
  }

  .clip.is-shown {
    visibility: visible;
  }

  .rail-label {
    opacity: 0;
    transform: translateX(0.5rem);
    transition:
      opacity 700ms var(--ease-fluid),
      transform 700ms var(--ease-fluid);
  }

  .rail-dot {
    transition:
      background-color 700ms var(--ease-fluid),
      transform 700ms var(--ease-fluid);
  }

  .rail-link:hover .rail-label,
  .rail-link:focus-visible .rail-label,
  .rail-link[aria-current='true'] .rail-label {
    opacity: 1;
    transform: none;
  }

  .rail-link:hover .rail-dot {
    background-color: var(--color-crema);
  }

  .rail-link[aria-current='true'] .rail-dot {
    background-color: var(--color-teja);
    transform: scale(1.5);
  }

  .hint-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-crema);
    animation: hint 2400ms var(--ease-fluid) infinite;
  }

  @keyframes hint {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hint-line::after {
      animation: none;
    }
  }
</style>
