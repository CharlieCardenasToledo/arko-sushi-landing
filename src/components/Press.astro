---
import Pending from './Pending.astro';
---

<section id="prensa" aria-labelledby="prensa-title" class="px-4 py-24 md:px-12 xl:px-24">
  <figure class="mx-auto flex max-w-4xl flex-col items-center text-center">
    <p id="prensa-title" data-reveal class="text-sm text-teja">Sobre esta propuesta</p>
    <blockquote data-reveal style="--d:100ms" class="mt-6">
      <p class="font-display text-3xl lg:text-5xl">“Una idea visual para contar Ecuador desde la mesa.”</p>
      <p class="mx-auto mt-6 max-w-2xl text-base text-crema/70 lg:text-lg">Este sitio es un prototipo personal. No tiene reseñas, cobertura de prensa ni actividad comercial asociada.</p>
    </blockquote>
    <figcaption data-reveal style="--d:200ms" class="mt-8 text-sm text-crema/70">Concepto de demostración · Ecuador</figcaption>
  </figure>
</section>
