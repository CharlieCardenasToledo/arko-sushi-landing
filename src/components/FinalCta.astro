---
import { Picture } from 'astro:assets';
import Spiral from './Spiral.astro';
import { photos } from '../data/arko';
---

<section id="reservar" aria-labelledby="final-title" class="relative overflow-hidden px-4 py-24 md:px-12 xl:px-24">
  <Spiral rings={12} class="pointer-events-none absolute right-0 bottom-0 w-[640px] translate-x-1/3 translate-y-1/3 text-crema/10" />
  <div class="relative mx-auto flex max-w-[680px] flex-col items-center text-center">
    <div data-reveal class="w-48 lg:w-56">
      <Picture src={photos.entrada} alt="Imagen de referencia del proyecto original Arko Restaurant en Barcelona" formats={['avif', 'webp']} widths={[320, 480]} sizes="224px" loading="lazy" decoding="async" pictureAttributes={{ class: 'block' }} class="aspect-[3/4] w-full mask-arch object-cover" />
    </div>
    <h2 id="final-title" data-reveal style="--d:100ms" class="mt-12 text-4xl lg:text-6xl">Una propuesta visual<br />con raíces ecuatorianas</h2>
    <p data-reveal style="--d:200ms" class="mt-6 text-base text-crema/70 lg:text-lg">Demo personal de Charlie Cárdenas Toledo. Los datos del negocio y la oferta gastronómica son ilustrativos.</p>
    <div data-reveal style="--d:300ms" class="mt-8"><a href="#contacto" class="btn btn-primary"><span>Créditos de desarrollo</span></a></div>
  </div>
</section>
